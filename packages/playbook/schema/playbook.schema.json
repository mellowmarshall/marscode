{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.dev/schemas/playbook.schema.json",
  "title": "Playbook declaration (evidence-only, stack-agnostic)",
  "description": "Repo declaration of applicable playbook sections, scoped exceptions, and repo-emitted playbook-evidence/v1 receipt locations. Playbook never runs linters, scanners, SQL parsers, or DB replays itself.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contracts"],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "evidenceDir": {
      "$ref": "#/$defs/path",
      "description": "Default directory holding untracked playbook-evidence/v1 JSON receipts (default: .playbook/evidence)."
    },
    "ci": {
      "type": "object",
      "additionalProperties": false,
      "description": "CI standards and execution tier evidence + ship-queue host routing metadata (PLAYBOOK §14).",
      "properties": {
        "evidence": {
          "type": ["string", "array"],
          "minLength": 1,
          "pattern": "^(?!/)(?!(.*/)?\\.\\.(/|$)).+",
          "items": {
            "type": "string",
            "pattern": "^(?!.*(^|/)\\.{1,2}(/|$))(?!.*//)[A-Za-z0-9._][A-Za-z0-9._/-]*$"
          },
          "description": "Path to the repo-emitted CI playbook-evidence/v1 JSON receipt, or list of failed-run diagnostic paths for ship-queue."
        },
        "none": {
          "$ref": "#/$defs/reason",
          "description": "Explicit opt-out reason when the repo has no CI."
        },
        "exceptions": {
          "$ref": "#/$defs/exceptions"
        },
        "parallel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64,
          "description": "Declared CI worker concurrency."
        },
        "select": {
          "type": ["string", "object"],
          "minLength": 1,
          "description": "Repo diff-selection command description, path, or path-to-suite map."
        },
        "full": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Globs whose change justifies full-suite selection."
        },
        "always": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Always-run gate commands."
        },
        "granularThresholdMs": {
          "type": "integer",
          "minimum": 1000,
          "description": "Stages exceeding this duration (ms, default 30000) must emit granular substeps[] timings (§14.2)."
        },
        "maxTier1Ms": {
          "type": "integer",
          "minimum": 1000,
          "description": "Tier 1 wall-time ceiling in ms (default 60000)."
        },
        "maxTier2Ms": {
          "type": "integer",
          "minimum": 1000,
          "description": "Tier 2 wall-time ceiling in ms (default 180000)."
        },
        "maxTier3Ms": {
          "type": "integer",
          "minimum": 1000,
          "description": "Tier 3 wall-time ceiling in ms (default 300000)."
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "secrets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "services": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*(@.+)?$"
          }
        },
        "settings": {
          "description": "CI settings mapping setting name to required host tools for ship-queue routing.",
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]*(@.+)?$"
            }
          }
        },
        "doppler": {
          "description": "PROJECT/CONFIG: Doppler configs minted for CI by ship-queue.",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*/[a-z0-9][a-z0-9_-]*$"
          }
        },
        "arch": {
          "description": "Host architectures eligible to run CI (ship-queue routing).",
          "type": "array",
          "items": {
            "enum": ["x86_64", "aarch64", "riscv64"]
          }
        }
      }
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "size": {
          "$ref": "#/$defs/sizeContract"
        },
        "generations": {
          "$ref": "#/$defs/sectionContract"
        },
        "intent": {
          "$ref": "#/$defs/intentContract"
        },
        "fleet": {
          "$ref": "#/$defs/fileSectionContract"
        },
        "dictionary": {
          "$ref": "#/$defs/fileSectionContract"
        },
        "migrations": {
          "$ref": "#/$defs/migrationsContract"
        },
        "actions": {
          "$ref": "#/$defs/fileSectionContract"
        },
        "design": {
          "$ref": "#/$defs/sectionContract"
        },
        "optimization": {
          "$ref": "#/$defs/fileSectionContract"
        },
        "maps": {
          "$ref": "#/$defs/fileSectionContract"
        },
        "tools": {
          "$ref": "#/$defs/sectionContract"
        },
        "docs": {
          "$ref": "#/$defs/docsContract"
        }
      }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\.\\.)[^\\0]+$"
    },
    "reason": {
      "type": "string",
      "minLength": 8
    },
    "issueRef": {
      "type": "string",
      "pattern": "^([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)?#[1-9][0-9]*$"
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "reason", "issue"],
      "properties": {
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "$ref": "#/$defs/reason"
        },
        "issue": {
          "$ref": "#/$defs/issueRef"
        }
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/exception"
      }
    },
    "sectionContract": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "none": {
          "$ref": "#/$defs/reason"
        },
        "evidence": {
          "$ref": "#/$defs/path"
        },
        "exceptions": {
          "$ref": "#/$defs/exceptions"
        },
        "choke": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "fileSectionContract": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "none": {
          "$ref": "#/$defs/reason"
        },
        "evidence": {
          "$ref": "#/$defs/path"
        },
        "exceptions": {
          "$ref": "#/$defs/exceptions"
        },
        "file": {
          "$ref": "#/$defs/path"
        },
        "choke": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sizeContract": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "none": {
          "$ref": "#/$defs/reason"
        },
        "evidence": {
          "$ref": "#/$defs/path"
        },
        "exceptions": {
          "$ref": "#/$defs/exceptions"
        },
        "allowlist": {
          "$ref": "#/$defs/path"
        },
        "maxLines": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        }
      }
    },
    "migrationsContract": {
      "type": "object",
      "additionalProperties": false,
      "description": "Stack-agnostic migration & destructive-DDL contract (§8): works with SurrealQL, Postgres, SQLite, Drizzle, Prisma, Alembic, Flyway, or any custom migrator via repo-emitted evidence.",
      "properties": {
        "none": {
          "$ref": "#/$defs/reason"
        },
        "evidence": {
          "$ref": "#/$defs/path"
        },
        "exceptions": {
          "$ref": "#/$defs/exceptions"
        },
        "engine": {
          "type": "string",
          "minLength": 1
        },
        "migrator": {
          "type": "string",
          "minLength": 1
        },
        "dir": {
          "$ref": "#/$defs/path"
        },
        "snapshot": {
          "$ref": "#/$defs/path"
        }
      }
    },
    "intentContract": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "none": {
          "$ref": "#/$defs/reason"
        },
        "evidence": {
          "$ref": "#/$defs/path"
        },
        "exceptions": {
          "$ref": "#/$defs/exceptions"
        },
        "contracts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "surface": {
              "$ref": "#/$defs/path"
            },
            "fleet": {
              "$ref": "#/$defs/path"
            },
            "dictionary": {
              "$ref": "#/$defs/path"
            },
            "actions": {
              "$ref": "#/$defs/path"
            },
            "slots": {
              "$ref": "#/$defs/path"
            }
          }
        }
      }
    },
    "docsContract": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "none": {
          "$ref": "#/$defs/reason"
        },
        "evidence": {
          "$ref": "#/$defs/path"
        },
        "exceptions": {
          "$ref": "#/$defs/exceptions"
        },
        "user": {
          "$ref": "#/$defs/path"
        },
        "admin": {
          "$ref": "#/$defs/path"
        }
      }
    }
  }
}
