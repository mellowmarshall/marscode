{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Optimization budgets (PLAYBOOK §11)",
  "description": "A repo's measurements and budgets. The host checks that every section is measured (or not applicable, with the reason), that every route and background job has a budget and every client action a receipt, and that the repo's receipts are fresh and within budget.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "measurements", "subjects"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "enum": [2]
    },
    "measurements": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "by": {
            "type": "string",
            "minLength": 1
          },
          "notApplicable": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    },
    "subjects": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/budget"
      }
    }
  },
  "$defs": {
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steps", "maxRoundTrips"],
      "properties": {
        "label": { "type": "string" },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "maxRoundTrips"],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]*$"
              },
              "optional": { "type": "boolean" },
              "maxRoundTrips": { "type": "integer", "minimum": 0 },
              "maxMs": { "type": "integer", "minimum": 0 },
              "justify": {
                "type": ["string", "array"],
                "items": { "type": "string" }
              }
            }
          }
        },
        "justify": {
          "type": ["string", "array"],
          "items": { "type": "string" }
        },
        "maxRoundTrips": { "type": "integer", "minimum": 0 },
        "maxMs": { "type": "integer", "minimum": 1 },
        "maxPayloadBytes": { "type": "integer", "minimum": 0 },
        "maxReadAmplification": { "type": "integer", "minimum": 1 },
        "maxEmptyScanAllowance": { "type": "integer", "minimum": 0 },
        "minFetchUtilization": { "type": "integer", "minimum": 0, "maximum": 100 },
        "minResponseUtilization": { "type": "integer", "minimum": 0, "maximum": 100 },
        "maxDeadStatements": { "type": "integer", "minimum": 0 },
        "maxFullScans": { "type": "integer", "minimum": 0 },
        "maxRenders": { "type": "integer", "minimum": 0 },
        "maxComponentRenders": { "type": "integer", "minimum": 0 },
        "maxApiCalls": { "type": "integer", "minimum": 0 },
        "maxDuplicateApiCalls": { "type": "integer", "minimum": 0 },
        "maxWaterfallDepth": { "type": "integer", "minimum": 0 },
        "maxTimers": { "type": "integer", "minimum": 0 },
        "maxPollIntervals": { "type": "integer", "minimum": 0 },
        "maxQueueEnqueues": { "type": "integer", "minimum": 0 },
        "maxJobStatements": { "type": "integer", "minimum": 0 },
        "maxRedisCalls": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
