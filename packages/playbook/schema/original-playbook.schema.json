{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["contracts"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "size": {
          "$ref": "#/$defs/size"
        },
        "tools": {
          "$ref": "#/$defs/tools"
        },
        "migrations": {
          "$ref": "#/$defs/migrations"
        },
        "dictionary": {
          "$ref": "#/$defs/dictionary"
        },
        "fleet": {
          "$ref": "#/$defs/fleet"
        },
        "generations": {
          "$ref": "#/$defs/generations"
        },
        "intent": {
          "$ref": "#/$defs/intent"
        },
        "actions": {
          "$ref": "#/$defs/actions"
        },
        "design": {
          "$ref": "#/$defs/design"
        },
        "optimization": {
          "$ref": "#/$defs/optimization"
        },
        "docs": {
          "$ref": "#/$defs/docs"
        }
      }
    },
    "ci": {
      "$ref": "#/$defs/ci"
    }
  },
  "$defs": {
    "ci": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "parallel": {
          "type": "integer",
          "minimum": 2
        },
        "select": {
          "type": "string",
          "minLength": 1
        },
        "full": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "always": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*(@.+)?$"
          }
        },
        "settings": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]*(@.+)?$"
            }
          }
        },
        "services": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          }
        },
        "secrets": {
          "type": "array",
          "items": {
            "enum": [
              "CLOUDFLARE_API_TOKEN",
              "DOPPLER_TOKEN",
              "FLY_API_TOKEN",
              "HCLOUD_TOKEN",
              "NEON_API_KEY",
              "OP_SERVICE_ACCOUNT_TOKEN"
            ]
          }
        },
        "doppler": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*/[a-z0-9][a-z0-9_-]*$"
          }
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?!.*(^|/)\\.{1,2}(/|$))(?!.*//)[A-Za-z0-9._-][A-Za-z0-9._/-]*$"
          }
        },
        "arch": {
          "type": "array",
          "items": {
            "enum": ["x86_64", "aarch64", "riscv64"]
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?!.*(^|/)\\.{1,2}(/|$))(?!.*//)[A-Za-z0-9._][A-Za-z0-9._/-]*$"
          }
        }
      }
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!(.*/)?\\.\\.(/|$)).+"
    },
    "optionalPath": {
      "type": ["string", "null"],
      "minLength": 1,
      "pattern": "^(?!/)(?!(.*/)?\\.\\.(/|$)).+"
    },
    "baseline": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!(.*/)?\\.\\.(/|$)).+"
    },
    "size": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "command": {
          "$ref": "#/$defs/command"
        },
        "exempt": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 10
          }
        },
        "baseline": {
          "$ref": "#/$defs/baseline"
        },
        "allowlist": {
          "$ref": "#/$defs/path"
        }
      },
      "required": ["command"]
    },
    "migrations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "migrator": {
          "type": "string",
          "enum": ["raw", "drizzle", "prisma", "alembic", "sqlx", "flyway"]
        },
        "dir": {
          "$ref": "#/$defs/optionalPath"
        },
        "list": {
          "$ref": "#/$defs/optionalPath"
        },
        "snapshot": {
          "$ref": "#/$defs/optionalPath"
        },
        "baseline": {
          "$ref": "#/$defs/baseline"
        },
        "protection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["override", "guards"],
          "properties": {
            "override": {
              "type": "string",
              "pattern": "^[a-z_][a-z0-9_.]*$"
            },
            "guards": {
              "type": "string",
              "pattern": "^[a-z_][a-z0-9_]*$"
            }
          }
        },
        "code": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "truncate": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "scripts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "replay": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "command": {
              "$ref": "#/$defs/command"
            },
            "engine": {
              "type": "string",
              "enum": ["postgres", "sqlite", "command"]
            },
            "image": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._/:@-]*$"
            },
            "database": {
              "type": "string",
              "pattern": "^[a-z_][a-z0-9_]*$"
            },
            "extensions": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z_][a-z0-9_-]*$"
              }
            }
          },
          "required": ["command"]
        },
        "lint": {
          "$ref": "#/$defs/command"
        },
        "render": {
          "$ref": "#/$defs/command"
        }
      }
    },
    "dictionary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file"],
      "properties": {
        "file": {
          "$ref": "#/$defs/path"
        },
        "baseline": {
          "$ref": "#/$defs/baseline"
        }
      }
    },
    "fleet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "reads"],
      "properties": {
        "file": {
          "$ref": "#/$defs/path"
        },
        "baseline": {
          "$ref": "#/$defs/baseline"
        },
        "reads": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "generations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": {
        "command": {
          "type": ["string", "null"],
          "minLength": 1
        }
      }
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contracts"],
      "properties": {
        "contracts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "surface": {
              "$ref": "#/$defs/path"
            },
            "fleet": {
              "$ref": "#/$defs/path"
            },
            "dictionary": {
              "$ref": "#/$defs/path"
            },
            "actions": {
              "$ref": "#/$defs/path"
            },
            "slots": {
              "$ref": "#/$defs/path"
            }
          }
        }
      }
    },
    "actions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file"],
      "properties": {
        "file": {
          "$ref": "#/$defs/path"
        },
        "baseline": {
          "$ref": "#/$defs/baseline"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "format": "regex"
        },
        "ledger": {
          "$ref": "#/$defs/path"
        },
        "walk_baseline": {
          "$ref": "#/$defs/baseline"
        },
        "held_back": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file"],
          "properties": {
            "file": {
              "$ref": "#/$defs/path"
            },
            "root": {
              "type": "string",
              "pattern": "^(?!/)(?!.*\\.\\.)"
            }
          }
        },
        "chokepoint": {
          "type": "boolean"
        },
        "floors": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["run", "tests"],
          "properties": {
            "run": {
              "$ref": "#/$defs/command"
            },
            "tests": {
              "type": "string",
              "minLength": 1,
              "format": "regex"
            }
          }
        },
        "walks": {
          "$ref": "#/$defs/path"
        },
        "closure": {
          "$ref": "#/$defs/command"
        },
        "measuredBy": {
          "type": ["string", "object"],
          "pattern": "^merge-gate$",
          "minProperties": 1,
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "additionalProperties": {
            "enum": ["merge-gate", "evidence"]
          }
        }
      }
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tokens": {
          "$ref": "#/$defs/optionalPath"
        },
        "ui": {
          "$ref": "#/$defs/optionalPath"
        },
        "interactive": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "style_properties": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "slots": {
          "$ref": "#/$defs/optionalPath"
        },
        "slot_calls": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "system": {
          "$ref": "#/$defs/optionalPath"
        },
        "baseline": {
          "$ref": "#/$defs/baseline"
        },
        "client": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "content_values": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "why"],
          "properties": {
            "source": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/path"
              }
            },
            "why": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        },
        "touch_calls": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "chokepoint": {
          "type": "boolean"
        }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steps"],
      "properties": {
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "python_external": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "optimization": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "file": {
          "$ref": "#/$defs/path"
        },
        "receipts": {
          "$ref": "#/$defs/path"
        },
        "measuredBy": {
          "enum": ["merge-gate"]
        },
        "baseline": {
          "$ref": "#/$defs/baseline"
        },
        "none": {
          "type": "string",
          "minLength": 10
        }
      }
    },
    "docs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user"],
      "properties": {
        "user": {
          "$ref": "#/$defs/path"
        },
        "admin": {
          "$ref": "#/$defs/path"
        },
        "user_triggers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "admin_triggers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "demo": {
          "type": "object",
          "additionalProperties": false,
          "required": ["command", "artifact"],
          "properties": {
            "command": {
              "$ref": "#/$defs/command"
            },
            "artifact": {
              "$ref": "#/$defs/path"
            },
            "triggers": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "command": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "class", "run", "languages"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "class": {
          "enum": ["lint", "typecheck", "deadcode", "deps", "format"]
        },
        "run": {
          "$ref": "#/$defs/command"
        },
        "languages": {
          "type": "array",
          "items": {
            "enum": [
              "ts",
              "js",
              "rust",
              "python",
              "shell",
              "go",
              "c",
              "cpp",
              "csharp",
              "java",
              "kotlin",
              "swift",
              "ruby",
              "php",
              "dart",
              "elixir",
              "scala",
              "zig",
              "lua",
              "r"
            ]
          }
        },
        "config": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          }
        }
      }
    }
  }
}
