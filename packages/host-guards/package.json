      "import": "./src/cli.ts"
    },
    "./cloud-cli-guard": {
      "types": "./src/cloudCliGuard.ts",
      "import": "./src/cloudCliGuard.ts"
    },
    "./git-guard": {
      "types": "./src/gitGuard.ts",
