    },
    "./shim-depth": {
      "types": "./src/shimDepth.ts",
      "import": "./src/shimDepth.ts"
    },
    "./tree-guard": {
      "types": "./src/treeGuard.ts",
      "import": "./src/treeGuard.ts"
