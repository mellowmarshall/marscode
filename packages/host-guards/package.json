    },
    "./hook": {
      "types": "./src/hook.ts",
      "import": "./src/hook.ts"
    },
    "./host-config": {
      "types": "./src/hostConfig.ts",
      "import": "./src/hostConfig.ts"
    },
    "./install-guard": {
      "types": "./src/installGuard.ts",
      "import": "./src/installGuard.ts"
    },
    "./merge-guard": {
      "types": "./src/mergeGuard.ts",
      "import": "./src/mergeGuard.ts"
    },
    "./override": {
      "types": "./src/override.ts",
      "import": "./src/override.ts"
    },
    "./ports-guard": {
      "types": "./src/portsGuard.ts",
