    {
      "name": "ffmpeg",
      "file": "infra/ci-host/ci-hosts.json",
      "lines": ["ffmpeg", "ffprobe"],
      "datasource": "github-releases",
      "depName": "BtbN/FFmpeg-Builds",
      "major": true,
      "monthEnd": true,
      "extractVersion": "^autobuild-(?<version>[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{2}-[0-9]{2})$",
      "versioning": "regex:^(?<major>\\d{4})-(?<minor>\\d{2})-(?<patch>\\d{2})-(?<build>\\d{2})-(?<revision>\\d{2})$",
      "allowedVersions": "/^\\d{4}-(01|03|05|07|08|10|12)-31-|^\\d{4}-(04|06|09|11)-30-|^\\d{4}-02-(28|29)-/",
      "match": "\"ffmpeg\": \\{[^\\n]*?/releases/download/autobuild-(?<currentValue>[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{2}-[0-9]{2})/",
      "derived": [
        {
          "name": "series",
          "read": "-gpl-([0-9]+\\.[0-9]+)(?![0-9.])",
          "source": {
            "kind": "file"
          }
        },
        {
          "name": "build",
          "read": "\\bv=(n[0-9][0-9A-Za-z.-]*);",
          "source": {
            "kind": "sums-name",
            "pattern": "ffmpeg-(n{series}(?:\\.[0-9]+)*-[0-9]+-g[0-9a-f]+)-linux64-gpl-{series}\\.tar\\.xz",
            "missing": "the release has no ffmpeg {series} build: raise the series (the install line's -gpl-X.Y) by hand"
          }
        }
      ],
      "assets": {
        "linux-x64": "https://github.com/BtbN/FFmpeg-Builds/releases/download/autobuild-{v}/ffmpeg-{build}-linux64-gpl-{series}.tar.xz",
        "linux-arm64": "https://github.com/BtbN/FFmpeg-Builds/releases/download/autobuild-{v}/ffmpeg-{build}-linuxarm64-gpl-{series}.tar.xz"
      },
      "sums": {
        "kind": "list",
        "url": "https://github.com/BtbN/FFmpeg-Builds/releases/download/autobuild-{v}/checksums.sha256"
      },
      "writer": {
        "kind": "case",
        "labels": {
          "linux-x64": "*)",
          "linux-arm64": "aarch64)"
        }
      },
      "floor": {
        "tools": ["ffmpeg", "ffprobe"],
        "from": "build",
        "pattern": "^n([0-9]+(?:\\.[0-9]+)*)"
      }
    },
