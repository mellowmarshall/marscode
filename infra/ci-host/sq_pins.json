{
  "schema": 1,
  "note": "The CI hosts' tool pins that `ship-queue deps` keeps current (private-repo): one entry per pin, read by Renovate as its custom regex managers (sq_deps_renovate.py) and by sq_pins.py, which the dependency exporter runs after Renovate moves a pin's anchor (match: Renovate's own regex, one currentValue). sq_pins.py then writes the version everywhere the pin's lines held the old one, its derived values (read: where the file holds one; source: where the release publishes it), and each platform's sha256 (assets: the download per platform; sums: list, a checksum file of the release; sidecar, a file beside each download; github-digest, the sha256 GitHub records for a release asset, for a project that publishes none; npm, the registry, which checks its own integrity; writer: where the sums sit, case arms, KEY=SHA256 words or a fleet script's case lines), and proves the result. A new major, and a new minor of a 0.x release, is never offered unless major is true (a human raises it); monthEnd keeps BtbN's month-end autobuilds, the ones the project keeps. Signatures (private-repo): a pin whose vendor signs its checksum list or its download names the signature and a key set of `keys` (pinned primary fingerprints; each fetched key is used only when it is that key), and refresh and prove both refuse a missing or bad signature; `unsigned` says why each other pin has none. Not here: the rust release (the release repos' rust-toolchain.toml pin; raised with them), cargo-audit and semgrep (unpinned), google-chrome and the playwright tools (current stable on purpose, refresh), the GNU userland bundle (macOS only, built from source, its BUNDLE raised with each pin), and the unmanaged lines below.",
  "pins": [
    {
      "name": "gitleaks",
      "file": "infra/ci-host/ci-hosts.json",
      "lines": ["gitleaks"],
      "datasource": "github-releases",
      "depName": "gitleaks/gitleaks",
      "extractVersion": "^v(?<version>.+)$",
      "match": "\"gitleaks\": \\{[^\\n]*?\"install\": \"v=(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+);",
      "assets": {
        "linux-x64": "https://github.com/gitleaks/gitleaks/releases/download/v{v}/gitleaks_{v}_linux_x64.tar.gz",
        "linux-arm64": "https://github.com/gitleaks/gitleaks/releases/download/v{v}/gitleaks_{v}_linux_arm64.tar.gz",
        "darwin-arm64": "https://github.com/gitleaks/gitleaks/releases/download/v{v}/gitleaks_{v}_darwin_arm64.tar.gz"
      },
      "sums": {
        "kind": "list",
        "url": "https://github.com/gitleaks/gitleaks/releases/download/v{v}/gitleaks_{v}_checksums.txt"
      },
      "writer": {
        "kind": "case",
        "labels": {
          "linux-x64": "'Linux x86_64')",
          "linux-arm64": "'Linux aarch64')",
          "darwin-arm64": "'Darwin arm64')"
        }
      },
      "no_floor": "its range is * on purpose: a distribution's gitleaks build prints no version (the manifest's gitleaks note), so no floor could judge a host"
    },
